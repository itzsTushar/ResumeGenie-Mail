// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// User Model
model User {
  userId            BigInt   @id @default(autoincrement())
  name              String
  email             String   @unique
  mobileNo          String?
  passwordEncrypted String?
  username          String   @unique
  accessToken       String?
  refreshToken      String?
  avatar            String?
  resume            String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  resumes    Resume[]
  excels     Excel[]
  otpSystems OtpSystem[]
}

// Resume stores the user's resume information
model Resume {
  resumeId BigInt @id @default(autoincrement())
  userId   BigInt

  name         String?
  email        String?
  mobileNo     String?
  introduction String?
  address      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [userId], onDelete: Cascade)
  educations     Education[]
  experiences    Experience[]
  projects       Project[]
  certifications Certification[]
  research       Research[]
  skills         ResumeSkill[]
  links          ResumeLink[]
}

// Education details associated with a resume
model Education {
  educationId BigInt @id @default(autoincrement())
  resumeId    BigInt

  institution String?
  degree      String?
  field       String?
  startYear   Int?
  endYear     Int?
  cgpa        Decimal? @db.Decimal(4, 2)
  description String?

  resume Resume @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
}

// Company information for work experience
model Company {
  companyId BigInt @id @default(autoincrement())

  name        String
  hrName      String?
  hrEmail     String?
  description String?

  // Relations
  experiences Experience[]
}

// Work experience associated with a resume
model Experience {
  experienceId BigInt  @id @default(autoincrement())
  resumeId     BigInt
  companyId    BigInt?

  role        String?
  startDate   DateTime?
  endDate     DateTime?
  description String?

  resume  Resume   @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [companyId], onDelete: SetNull)
}

// Project details associated with a resume
model Project {
  projectId BigInt @id @default(autoincrement())
  resumeId  BigInt

  title        String
  description  String?
  technologies String?
  github       String?
  liveLink     String?
  startDate    DateTime?
  endDate      DateTime?

  resume Resume @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
}

// Certification details associated with a resume
model Certification {
  certificationId BigInt @id @default(autoincrement())
  resumeId        BigInt

  name          String
  issuer        String?
  issueDate     DateTime?
  credentialId  String?
  credentialUrl String?

  resume Resume @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
}

// Research and publication details associated with a resume
model Research {
  researchId BigInt @id @default(autoincrement())
  resumeId   BigInt

  topic    String?
  title    String?
  journal  String?
  year     Int?
  doi      String?
  abstract String?
  url      String?

  resume Resume @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
}

// Skills master table
model Skill {
  skillId BigInt @id @default(autoincrement())

  name String @unique

  // Relations
  resumes ResumeSkill[]
}

// Junction: Resume ↔ Skill
model ResumeSkill {
  resumeId BigInt
  skillId  BigInt

  resume Resume @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [skillId], onDelete: Cascade)

  @@id([resumeId, skillId])
}

// Links associated with a resume
model ResumeLink {
  resumeLinkId BigInt @id @default(autoincrement())
  resumeId     BigInt

  type String
  url  String

  resume Resume @relation(fields: [resumeId], references: [resumeId], onDelete: Cascade)
}

// Excel files uploaded by a user
model Excel {
  excelId BigInt @id @default(autoincrement())
  userId  BigInt

  title String?
  file  String?

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
}

// OTP system for user authentication/verification
model OtpSystem {
  otpId  BigInt @id @default(autoincrement())
  userId BigInt

  type      String?
  otp       String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [userId], onDelete: Cascade)
}
